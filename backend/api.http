### 
@baseUrl = http://localhost:3000/api
@token = TU_TOKEN_JWT_AQUI

### 1. 
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Admin Demo",
  "email": "admin@empresa.com",
  "password": "password123"
}

### 2. Login 
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@empresa.com",
  "password": "password123"
}

###  
GET {{baseUrl}}/vehiculos
Authorization: Bearer {{token}}

### 
POST {{baseUrl}}/vehiculos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "marca": "Mercedes-Benz",
  "modelo": "Actros 2045",
  "patente": "AB123CD",
  "anio": 2022,
  "capacidad_carga": 18500.00
}

### 
GET {{baseUrl}}/vehiculos/1
Authorization: Bearer {{token}}

### 
PUT {{baseUrl}}/vehiculos/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "marca": "Mercedes-Benz",
  "modelo": "Actros 2045 Evo",
  "patente": "AB123CD",
  "anio": 2023,
  "capacidad_carga": 19000.00
}

### 
GET {{baseUrl}}/vehiculos/1/kilometros
Authorization: Bearer {{token}}

### 
POST {{baseUrl}}/conductores
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Juan",
  "apellido": "Pérez",
  "dni": "35123456",
  "numero_licencia": "LIC-35123456",
  "fecha_alta_licencia": "2020-01-15",
  "fecha_vencimiento_licencia": "2028-01-15"
}

### 
GET {{baseUrl}}/conductores/1/kilometros
Authorization: Bearer {{token}}

### 
POST {{baseUrl}}/viajes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "vehiculo_id": 1,
  "conductor_id": 1,
  "fecha_salida": "2026-10-01T08:00:00",
  "fecha_llegada": "2026-10-01T16:30:00",
